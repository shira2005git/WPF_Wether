<Window x:Class="WetherSideClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WetherSideClient.Convert"
        Title="Weather App" Height="600" Width="900"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- קונברטר צבעי טמפרטורה -->
        <local:TempToBrushConverter x:Key="TempToBrushConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- שורת חיפוש -->
            <RowDefinition Height="*"/>
            <!-- תוכן -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <!-- Forecast -->
            <ColumnDefinition Width="2*"/>
            <!-- היסטוריה -->
            <ColumnDefinition Width="2*"/>
            <!-- מועדפים -->
        </Grid.ColumnDefinitions>

        <!-- חיפוש -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBox Height="30" Width="250"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"/>
            <Button Height="30" Width="40" Margin="5,0,0,0"
                    Command="{Binding SearchCommand}">
                <Image Source="/Images/אייקון.png" Stretch="Uniform"/>
            </Button>
        </StackPanel>

        <!-- Forecast -->
        <ScrollViewer Grid.Column="0" Grid.Row="1" Margin="0,0,10,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Forecast}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- רשת אוטומטית שתסתדר יפה -->
                        <UniformGrid Columns="1" MinWidth="200" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="15" Padding="10" Margin="10" MinWidth="160" MinHeight="160">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource TempToBrushConverter}">
                                    <Binding Path="MaxTemp"/>
                                    <Binding Path="MinTemp"/>
                                </MultiBinding>
                            </Border.Background>

                            <StackPanel HorizontalAlignment="Center">
                                <!-- תאריך -->
                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dddd, dd MMM}'}" 
                                           FontWeight="Bold" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>

                                <!-- אייקון -->
                                <Image Source="{Binding IconUrl}" Width="50" Height="50" Margin="5"/>

                                <!-- טמפרטורה -->
                                <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center">
                                    <Run Text="▲ "/>
                                    <Run Text="{Binding MaxTemp, StringFormat={}{0}°}" />
                                    <Run Text="  " />
                                    <Run Text="▼ "/>
                                    <Run Text="{Binding MinTemp, StringFormat={}{0}°}" />
                                </TextBlock>

                                <!-- תיאור -->
                                <TextBlock Text="{Binding Summary}" FontStyle="Italic" FontSize="12" 
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- היסטוריה -->
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,10,0">
            <TextBlock Text="היסטוריה" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding HistoryCities}" Height="400">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="150">
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.SearchHistoryCityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </TextBlock.InputBindings>
                            </TextBlock>

                            <Button Width="25" Height="25"
                                    Command="{Binding DataContext.AddFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Name}">
                                <TextBlock Text="★" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- מועדפים -->
        <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,0">
            <TextBlock Text="מועדפים" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding FavoriteCities}" Height="400">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

    </Grid>
</Window>
